rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ─────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin status is stored on the user's own profile document, not on a
    // custom claim, to keep everything on the free Spark plan (no Cloud
    // Functions needed to mint custom claims). The profile doc is only
    // writable by admins (see /users rules below), so a student cannot
    // grant themselves the admin role.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isActive() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Bootstraps the very first admin account without needing a Cloud
    // Function to mint it server-side. This list MUST be kept in sync by
    // hand with the NEXT_PUBLIC_SEED_ADMIN_EMAILS env var read in
    // src/components/auth/AuthProvider.tsx — that's the only other place
    // this decision is made. Emails are matched lowercase; a bare email
    // string here does not grant anything by itself, it only allows THAT
    // signed-in, verified account to create its own profile with
    // role == 'admin' the first time (create only — see /users rules).
    // Add/remove an email here whenever you change the env var.
    function isSeedAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() in ['salmanshafiq00@gmail.com', 'shofiq.dev@gmail.com'];
    }

    // ── Shape/validation helpers ───────────────────────────────────────
    // These validate "IF the field is present in the resulting document,
    // it must be well-formed" rather than "the field must always be
    // present." Most write paths in this app use partial
    // setDoc(ref, patch, {merge:true}) / updateDoc() / batch.update() calls
    // that only touch a handful of fields at a time (e.g.
    // reorderPersonalVideoList only ever writes {priorityOrder,
    // updatedAt}). Firestore evaluates request.resource.data for those
    // calls as the *merged resulting document*, so requiring a field to
    // always be present would reject legitimate partial writes the very
    // first time a doc happens to be touched by an incomplete patch.
    // Range/enum/type checks still catch a malformed or hostile value
    // every time that field does appear.
    function optionalString(data, key, maxLen) {
      return !(key in data) || data[key] == null ||
        (data[key] is string && data[key].size() <= maxLen);
    }

    function optionalNumberInRange(data, key, min, max) {
      return !(key in data) ||
        (data[key] is number && data[key] >= min && data[key] <= max);
    }

    function optionalNullableNumberInRange(data, key, min, max) {
      return !(key in data) || data[key] == null ||
        (data[key] is number && data[key] >= min && data[key] <= max);
    }

    function optionalIntInRange(data, key, min, max) {
      return !(key in data) || (data[key] is int && data[key] >= min && data[key] <= max);
    }

    function validReaderProgress(data) {
      return !('readerProgress' in data) || data.readerProgress == null ||
        (data.readerProgress is map &&
          data.readerProgress.keys().hasAll(['lastPage', 'zoom', 'updatedAt']) &&
          data.readerProgress.keys().hasOnly(['lastPage', 'zoom', 'updatedAt', 'scrollRatio', 'sheetIndex', 'rowIndex']) &&
          optionalNumberInRange(data.readerProgress, 'scrollRatio', 0, 1) &&
          optionalIntInRange(data.readerProgress, 'sheetIndex', 0, 200) &&
          optionalIntInRange(data.readerProgress, 'rowIndex', 0, 1000000) &&
          data.readerProgress.lastPage is int &&
          data.readerProgress.lastPage >= 1 && data.readerProgress.lastPage <= 100000 &&
          data.readerProgress.zoom is number &&
          data.readerProgress.zoom >= 0.1 && data.readerProgress.zoom <= 10 &&
          data.readerProgress.updatedAt is timestamp);
    }

    function optionalBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function optionalEnum(data, key, allowed) {
      return !(key in data) || data[key] in allowed;
    }

    function optionalNullableEnum(data, key, allowed) {
      return !(key in data) || data[key] == null || data[key] in allowed;
    }

    function optionalTimestamp(data, key) {
      return !(key in data) || data[key] == null || data[key] is timestamp;
    }

    function sameDriveReferences() {
      return request.resource.data.get('driveFileId', null) == resource.data.get('driveFileId', null) &&
        request.resource.data.get('driveConnectionId', null) == resource.data.get('driveConnectionId', null) &&
        request.resource.data.get('googleNative', null) == resource.data.get('googleNative', null);
    }

    // Field validation shared by create and update of a personal video
    // (users/{uid}/personalPlaylists/{id}/videos/{id}). Takes the resulting
    // document so it is only ever evaluated on writes that carry one (never on
    // delete, where request.resource is null).
    function validPersonalVideoFields(data) {
      return optionalString(data, 'title', 500) &&
        optionalEnum(data, 'status', ['not_started', 'in_progress', 'completed']) &&
        optionalNumberInRange(data, 'watchedPercentage', 0, 100) &&
        optionalNumberInRange(data, 'currentPositionSeconds', 0, 1000000000) &&
        optionalBool(data, 'isFavorite') &&
        optionalBool(data, 'isWatchLater') &&
        optionalNullableEnum(data, 'priority', ['high', 'medium', 'low']) &&
        optionalNumberInRange(data, 'order', 0, 1000000) &&
        optionalNullableNumberInRange(data, 'durationSeconds', 0, 1000000000) &&
        // watchLaterOrder / priorityOrder hold either a list index or Date.now().
        optionalNullableNumberInRange(data, 'watchLaterOrder', 0, 1000000000000000) &&
        optionalNullableNumberInRange(data, 'priorityOrder', 0, 1000000000000000) &&
        optionalString(data, 'categoryId', 200) &&
        optionalString(data, 'driveFileId', 200) &&
        optionalString(data, 'driveConnectionId', 200) &&
        // thumbnailData is deprecated (legacy base64). Remove this line once the
        // thumbnail backfill has migrated every document (roadmap R3).
        optionalString(data, 'thumbnailData', 40960);
    }

    // Field validation shared by create and update of a Study Materials
    // document (users/{uid}/personalDocuments/{id}).
    function validPersonalDocumentFields(data) {
      return optionalString(data, 'title', 300) &&
        optionalEnum(data, 'fileType', ['pdf', 'docx', 'pptx', 'xlsx']) &&
        optionalString(data, 'mimeType', 200) &&
        optionalString(data, 'driveFileId', 200) &&
        optionalString(data, 'driveConnectionId', 200) &&
        optionalString(data, 'md5Checksum', 100) &&
        optionalString(data, 'modifiedTime', 100) &&
        optionalBool(data, 'googleNative') &&
        optionalString(data, 'categoryId', 200) &&
        optionalString(data, 'thumbnailUrl', 500) &&
        // sizeBytes is written as null when Drive does not report a size.
        optionalNullableNumberInRange(data, 'sizeBytes', 0, 100000000000) &&
        validReaderProgress(data) &&
        // thumbnailData is deprecated (legacy base64). Remove this line once the
        // thumbnail backfill has migrated every document (roadmap R3).
        optionalString(data, 'thumbnailData', 40960);
    }

    // ── Sharing state helpers ───────────────────────────────────────────
    function isShareRevoked(data) {
      return ('revokedAt' in data) && data.revokedAt != null;
    }

    // A missing `expiresAt` field (every share doc written before this
    // feature existed) is treated as "never expires" via the `'expiresAt'
    // in data` existence check — reading a missing map key directly (e.g.
    // `data.expiresAt`) throws in these rules and would otherwise lock
    // every pre-existing share out the moment this rule deployed.
    function isShareExpired(data) {
      return ('expiresAt' in data) && data.expiresAt != null && data.expiresAt < request.time;
    }

    function isShareActive(data) {
      return !isShareRevoked(data) && !isShareExpired(data);
    }

    // ── Users & personal learning data ─────────────────────────────────
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // Users may create only their own student profile. Admin profiles must
      // be provisioned server-side; allowing a client to choose "admin" here
      // would turn a crafted first sign-in write into privilege escalation.
      // A profile is only created once the email is verified (Google accounts always are), so a
      // brand-new email/password sign-up cannot start using the app before confirming its address.
      allow create: if isSelf(uid) &&
        request.auth.token.email_verified == true &&
        (request.resource.data.role == 'student' ||
          (request.resource.data.role == 'admin' && isSeedAdminEmail())) &&
        request.resource.data.status in ['active', 'disabled'];
      // Users may update their own profile EXCEPT role/status (privilege
      // escalation guard). Admins may update anything on any profile.
      allow update: if isAdmin() ||
        (isSelf(uid) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();

      match /videoStates/{videoId} {
        allow read: if isSelf(uid) || isAdmin();
        // status/priority are closed enums and watchedPercentage is a
        // 0-100 gauge the UI (progress bars, "in progress" filters) trusts
        // outright — a client bug or tampered write pushing an
        // out-of-range or made-up value would otherwise corrupt those
        // views silently.
        allow write: if (isSelf(uid) || isAdmin()) &&
          optionalEnum(request.resource.data, 'status', ['not_started', 'in_progress', 'completed']) &&
          optionalNumberInRange(request.resource.data, 'watchedPercentage', 0, 100) &&
          optionalNumberInRange(request.resource.data, 'currentPositionSeconds', 0, 1000000000) &&
          optionalBool(request.resource.data, 'isFavorite') &&
          optionalBool(request.resource.data, 'isWatchLater') &&
          optionalNullableEnum(request.resource.data, 'priority', ['high', 'medium', 'low']);
      }

      // Size-guarded so a runaway autosave loop or a large paste can't
      // create multi-megabyte documents that blow through the free-tier
      // storage quota. 50,000 chars is still ample for rich-text HTML
      // summaries and notes while staying far above any normal student
      // typing volume.
      match /notes/{videoId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if (isSelf(uid) || isAdmin()) &&
          request.resource.data.content is string &&
          request.resource.data.content.size() <= 50000 &&
          optionalNullableNumberInRange(request.resource.data, 'pageNumber', 1, 100000);
        allow delete: if isSelf(uid) || isAdmin();
      }
      match /summaries/{videoId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if (isSelf(uid) || isAdmin()) &&
          request.resource.data.content is string &&
          request.resource.data.content.size() <= 50000;
        allow delete: if isSelf(uid) || isAdmin();
      }

      // Manually pasted/uploaded transcripts (Phase 4 — universal
      // transcript input for non-YouTube videos). Same per-user, per-video
      // shape and size guard as notes/summaries above.
      match /transcripts/{videoId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if (isSelf(uid) || isAdmin()) &&
          request.resource.data.content is string &&
          request.resource.data.content.size() <= 50000;
        allow delete: if isSelf(uid) || isAdmin();
      }

      match /bookmarks/{videoId}/items/{bookmarkId} {
        allow read: if isSelf(uid) || isAdmin();
        // Bookmarks are create-once/delete (addBookmark/removeBookmark —
        // no update path), so the shape can be required outright rather
        // than optionally.
        allow create: if (isSelf(uid) || isAdmin()) &&
          request.resource.data.videoId is string &&
          request.resource.data.timestampSeconds is number &&
          request.resource.data.timestampSeconds >= 0 &&
          request.resource.data.label is string &&
          request.resource.data.label.size() <= 500;
        allow delete: if isSelf(uid) || isAdmin();
      }

      match /favoritePlaylists/{playlistId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }

      match /goals/{goalId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if (isSelf(uid) || isAdmin()) &&
          optionalString(request.resource.data, 'title', 500) &&
          optionalString(request.resource.data, 'notes', 5000) &&
          optionalNullableEnum(request.resource.data, 'priority', ['high', 'medium', 'low']) &&
          optionalBool(request.resource.data, 'completed');
      }

      // In-app notifications. Trigger-based notifications are written by
      // server-side logic via the Admin SDK (which bypasses these rules), so
      // `create` is denied to the client outright: no client action ever
      // creates one directly, and allowing it would let any signed-in user
      // forge a notification into their own feed. Clients only read them and
      // flip `read` — that's an update, not a create.
      match /notifications/{notificationId} {
        allow read: if isSelf(uid) || isAdmin();
        allow update: if (isSelf(uid) || isAdmin()) &&
          optionalBool(request.resource.data, 'read') &&
          optionalTimestamp(request.resource.data, 'readAt') &&
          optionalString(request.resource.data, 'title', 500) &&
          optionalString(request.resource.data, 'body', 2000) &&
          optionalString(request.resource.data, 'linkHref', 500) &&
          optionalEnum(request.resource.data, 'type', ['goal_pace', 'roadmap_ready', 'system']);
        allow delete: if isSelf(uid) || isAdmin();
      }

      match /quizAttempts/{attemptId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if (isSelf(uid) || isAdmin()) &&
          request.resource.data.videoId is string &&
          request.resource.data.score is number &&
          request.resource.data.totalQuestions is number &&
          request.resource.data.totalQuestions <= 50 &&
          optionalString(request.resource.data, 'categoryId', 200) &&
          optionalTimestamp(request.resource.data, 'completedAt');
        allow delete: if isSelf(uid) || isAdmin();
      }

      // P3: one aggregate document per local day (yyyy-MM-dd). Owner-only, fixed key allowlist, bounded numbers.
      match /learningDays/{day} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(uid) &&
          day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          request.resource.data.keys().hasOnly(['events', 'byEvent', 'watchSeconds', 'docMinutes', 'quizzes', 'updatedAt']) &&
          (!('events' in request.resource.data) || (request.resource.data.events is number && request.resource.data.events <= 100000)) &&
          (!('watchSeconds' in request.resource.data) || (request.resource.data.watchSeconds is number && request.resource.data.watchSeconds <= 86400)) &&
          (!('docMinutes' in request.resource.data) || (request.resource.data.docMinutes is number && request.resource.data.docMinutes <= 1440)) &&
          (!('quizzes' in request.resource.data) || (request.resource.data.quizzes is number && request.resource.data.quizzes <= 10000)) &&
          (!('byEvent' in request.resource.data) || (request.resource.data.byEvent is map && request.resource.data.byEvent.size() <= 20));
        allow delete: if false;
      }

      // Legacy (before P3). No new writes are made by the app; kept readable until the P6 cleanup removes old events.
      match /learningEvents/{eventId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid) &&
          request.resource.data.eventName is string &&
          request.resource.data.eventName.size() <= 100 &&
          request.resource.data.metadata is map &&
          request.resource.data.metadata.size() <= 20;
        allow update, delete: if false;
      }

      match /watchProgress/{videoId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if (isSelf(uid) || isAdmin()) &&
          optionalNumberInRange(request.resource.data, 'currentSeconds', 0, 1000000000) &&
          optionalNumberInRange(request.resource.data, 'percentComplete', 0, 100);
      }

      // Personal Playlists/videos the student creates themselves. Private
      // by path: only the owner and admins can ever reach this subtree —
      // no other student's rules path grants access to it. Named distinctly
      // from the top-level /playlists collection (the shared library) to
      // avoid any confusion between the two content tiers.
      match /personalPlaylists/{playlistId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if (isSelf(uid) || isAdmin()) &&
          optionalString(request.resource.data, 'title', 300) &&
          optionalString(request.resource.data, 'description', 5000) &&
          optionalEnum(request.resource.data, 'visibility', ['private', 'link', 'public']) &&
          optionalBool(request.resource.data, 'isUnsorted') &&
          optionalBool(request.resource.data, 'autoPlay') &&
          optionalBool(request.resource.data, 'summaryStale') &&
          optionalNumberInRange(request.resource.data, 'videoCount', 0, 1000000) &&
          optionalNumberInRange(request.resource.data, 'totalDurationSeconds', 0, 1000000000) &&
          optionalString(request.resource.data, 'categoryId', 200);

        match /videos/{videoId} {
          allow read: if isSelf(uid) || isAdmin();
          allow create: if (isSelf(uid) || isAdmin()) &&
            validPersonalVideoFields(request.resource.data);

          allow update: if (isSelf(uid) || isAdmin()) && sameDriveReferences() &&
            validPersonalVideoFields(request.resource.data);

          // Delete used to share the create rule, which reads
          // request.resource.data; that is null on delete, so the rule errored
          // and every client-side video delete was denied.
          allow delete: if isSelf(uid) || isAdmin();

          match /quiz/{quizDoc} {
            allow read: if isSelf(uid) || isAdmin();
            allow write: if false;
          }
        }
      }

      match /categories/{categoryId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if (isSelf(uid) || isAdmin()) &&
          request.resource.data.createdBy == uid &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          optionalString(request.resource.data, 'nameLower', 200);
        allow update, delete: if isSelf(uid) || isAdmin();
      }

      match /learningRoadmaps/{roadmapId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(uid) &&
          request.resource.data.categoryId is string &&
          request.resource.data.level in ['basic', 'intermediate', 'advanced'] &&
          request.resource.data.steps is list &&
          optionalTimestamp(request.resource.data, 'adoptedFromTemplateAt') &&
          optionalTimestamp(request.resource.data, 'updatedAt');
        allow delete: if isSelf(uid) || isAdmin();
      }

      // AI provider connections (encrypted API keys). Denied to the client
      // SDK entirely, even for the owner — defense in depth so
      // encryptedApiKey can never round-trip through client code, by
      // accident or via a future client-side query bug. All access goes
      // through the authenticated /api/ai/connections* routes, which use
      // the Admin SDK (bypasses these rules) and only ever return a masked
      // projection. See src/lib/server/aiEncryption.ts.
      match /aiConnections/{connectionId} {
        allow read, write: if false;
      }

      match /aiQuota/{quotaId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }

      // Google Drive OAuth connections (encrypted refresh tokens). Denied to
      // the client SDK entirely, same reasoning as aiConnections above — all
      // access goes through /api/drive/* routes using the Admin SDK. See
      // src/lib/server/driveConnections.ts.
      match /driveConnections/{connectionId} {
        allow read, write: if false;
      }

      // P4: pointers to Study Lamp's own files in the user's Drive ("Study Lamp data"). Server-only (Admin SDK).
      match /blobs/{blobId} {
        allow read, write: if false;
      }

      // Google Workspace OAuth connections (encrypted refresh tokens for the
      // narrower Calendar/Tasks scopes). Denied to the client SDK entirely;
      // all access goes through /api/google/* routes using the Admin SDK. See
      // src/lib/server/googleConnections.ts.
      match /googleConnections/{connectionId} {
        allow read, write: if false;
      }

      // Goal↔Google mapping docs, one per goal: users/{uid}/googleSync/{goalId}
      // (see src/lib/server/googleSyncMapping.ts). Server-only: written and read by
      // the Admin SDK, so the client SDK can never read or forge a mapping.
      match /googleSync/{mappingId} {
        allow read, write: if false;
      }

      // Sync history (Z3 item 4). Server-only: written by saveSyncLogEntry, read by
      // listSyncLog — both via the Admin SDK. Holds goal-level fields only.
      match /googleSyncLog/{entryId} {
        allow read, write: if false;
      }

      // Remote items the user chose to ignore (Z3 item 5). Server-only.
      match /googleIgnored/{ignoredId} {
        allow read, write: if false;
      }

      // Quiz attempts already added to a Google Sheet (Z2): users/{uid}/googleExports/{attemptId}_{documentId}.
      // Server-only: written by markAttemptsExported, read by loadExportedAttemptIds (Admin SDK).
      match /googleExports/{exportId} {
        allow read, write: if false;
      }

      // Spent one-time plan tokens (Z3 item 6). Server-only.
      match /googleUsedTokens/{jti} {
        allow read, write: if false;
      }

      // Drive thumbnail bytes ({connectionId}_{fileId}). Server-only: written and
      // read by the Admin SDK (thumbnail route, import, backfill) so the images
      // never ride along with video/document documents. See driveThumbnails.ts.
      match /driveThumbs/{thumbId} {
        allow read, write: if false;
      }

      // Study Materials (PDFs / Office docs) — Phase 18-19. The file bytes
      // live in Drive; this doc is just metadata + provenance, so the same
      // owner-or-admin + size-guard pattern as personalPlaylists applies.
      match /personalDocuments/{documentId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if (isSelf(uid) || isAdmin()) &&
          validPersonalDocumentFields(request.resource.data);

        allow update: if (isSelf(uid) || isAdmin()) && sameDriveReferences() &&
          validPersonalDocumentFields(request.resource.data);

        // Removal goes through DELETE /api/documents/[id] (Admin SDK) so the
        // quiz/content/annotations subcollections are deleted too; Firestore
        // does not cascade. Direct owner deletes of the parent are still allowed.
        allow delete: if isSelf(uid) || isAdmin();

        // AI-generated quiz cache, same shape/rules as a video's — written
        // only by server-side Admin SDK code (see src/lib/server/quiz.ts).
        match /quiz/{quizDoc} {
          allow read: if isSelf(uid) || isAdmin();
          allow write: if false;
        }

        match /content/{contentDoc} {
          allow read, write: if false;
        }

        match /annotations/{annotationDoc} {
          allow read: if isSelf(uid) && annotationDoc == 'main';
          allow create, update: if isSelf(uid) && annotationDoc == 'main' &&
            request.resource.data.annotationsJson is string &&
            request.resource.data.annotationsJson.size() <= 850000 &&
            optionalTimestamp(request.resource.data, 'updatedAt');
          allow delete: if isSelf(uid) && annotationDoc == 'main';
        }
      }
    }

    match /roadmapTemplates/{templateId} {
      allow read: if isSignedIn() && isActive();
      allow write: if false;
    }

    match /categorySuggestions/{suggestionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isActive() &&
        request.resource.data.suggestedName is string &&
        request.resource.data.suggestedName.size() > 0 &&
        request.resource.data.suggestedBy == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isAdmin() &&
        request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if isAdmin();
    }

    match /systemAiSettings/{docId} {
      allow read: if isSignedIn() && isActive();
      allow write: if false;
    }

    // Admin-owned AI provider connections for the shared system tier.
    // These are server-only, admin-SDK-backed documents with the same
    // encrypted-key shape as the user-owned equivalents; clients and
    // students never read or write them directly.
    match /systemAiConnections/{connectionId} {
      allow read, write: if false;
    }

    // ── Shared learning library ─────────────────────────────────────────
    // Admin-curated Suggested content. Readable by any signed-in, active
    // user; writable only by admins. The technical collection path remains
    // /playlists even though the student-facing route is /suggested.
    match /playlists/{playlistId} {
      allow read: if isSignedIn() && isActive();
      allow write: if isAdmin() &&
        optionalString(request.resource.data, 'title', 300) &&
        optionalEnum(request.resource.data, 'visibility', ['shared', 'archived']) &&
        optionalNumberInRange(request.resource.data, 'videoCount', 0, 1000000);

      match /videos/{videoId} {
        allow read: if isSignedIn() && isActive();
        allow write: if isAdmin() &&
          optionalString(request.resource.data, 'title', 500) &&
          optionalNumberInRange(request.resource.data, 'order', 0, 1000000);

        match /quiz/{quizDoc} {
          allow read: if isSignedIn() && isActive();
          allow write: if false;
        }
      }
      match /videoTags/{videoTagId} {
        allow read: if isSignedIn() && isActive();
        allow write: if isAdmin();
      }
    }

    match /shares/{shareToken} {
      // Owners need to read their own inactive records so the share dialog
      // can find and update an existing share after it was revoked/expired.
      // Inactive records remain hidden from everyone else.
      allow read: if isSelf(resource.data.ownerUid) || isAdmin() ||
        (isShareActive(resource.data) &&
          (resource.data.visibility != 'private' || (('recipientUid' in resource.data) && isSelf(resource.data.recipientUid))));
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.shareToken == shareToken &&
        request.resource.data.entityType in ['video', 'playlist'] &&
        request.resource.data.visibility in ['private', 'unlisted', 'public'] &&
        request.resource.data.revokedAt == null &&
        optionalTimestamp(request.resource.data, 'expiresAt') &&
        optionalString(request.resource.data, 'recipientEmail', 320) &&
        optionalString(request.resource.data, 'recipientUid', 200) &&
        optionalNullableEnum(request.resource.data, 'approvalStatus', ['pending', 'accepted', 'rejected']);
      allow update: if ((isSelf(resource.data.ownerUid) || isAdmin()) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.shareToken == shareToken &&
        request.resource.data.entityType == resource.data.entityType &&
        request.resource.data.visibility in ['private', 'unlisted', 'public'] &&
        optionalTimestamp(request.resource.data, 'expiresAt')) ||
        (('recipientUid' in resource.data) && isSelf(resource.data.recipientUid) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.shareToken == shareToken &&
          request.resource.data.approvalStatus in ['accepted', 'rejected']);
      allow delete: if isSelf(resource.data.ownerUid) || isAdmin();
    }

    match /tags/{tagId} {
      allow read: if isSignedIn() && isActive();
      allow create: if isSignedIn() && isActive() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        optionalString(request.resource.data, 'nameLower', 200);
      allow update, delete: if isAdmin();
    }

    match /videoTags/{videoTagId} {
      allow read: if isSignedIn() && isActive();
      allow write: if isAdmin();
    }
  }
}