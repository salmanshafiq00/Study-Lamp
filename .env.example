# [public] Firebase Web API key.
NEXT_PUBLIC_FIREBASE_API_KEY=
# [public] Firebase Authentication domain.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# [public] Firebase project ID used by the client.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# [public] Firebase Storage bucket.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# [public] Firebase messaging sender ID.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# [public] Firebase Web app ID.
NEXT_PUBLIC_FIREBASE_APP_ID=
# [public] Canonical application URL used for OAuth redirects.
NEXT_PUBLIC_APP_URL=
# [public] Comma-separated seed-admin emails; keep in sync with firestore.rules.
NEXT_PUBLIC_SEED_ADMIN_EMAILS=
# [public] Feature flag indicating YouTube API availability.
NEXT_PUBLIC_HAS_YT_KEY=
# [public] Facebook app ID for video embeds/import.
NEXT_PUBLIC_FACEBOOK_APP_ID=
# [public] Google Picker API key.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# [server-only] Firebase project ID for Firebase Admin (falls back to the public project ID).
FIREBASE_PROJECT_ID=
# [server-only] Firebase Admin service-account client email.
FIREBASE_CLIENT_EMAIL=
# [server-only] Firebase Admin service-account private key; preserve escaped newlines.
FIREBASE_PRIVATE_KEY=
# [server-only] Base64-encoded 32-byte key used to encrypt stored AI credentials.
AI_CONNECTION_ENCRYPTION_KEY=
# [server-only] Previous key kept temporarily while stored AI and Drive credentials are re-encrypted.
AI_CONNECTION_ENCRYPTION_KEY_PREVIOUS=
# [server-only, recommended] ONE Google OAuth client for Drive, Calendar and Tasks. Used by both flows.
# The client secret only changes when you rotate it in Google Cloud Console (it does not expire by itself).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# [server-only, recommended] ONE secret that signs the OAuth state of every Google flow (the Drive and Workspace
# states are domain-separated by prefix). Generate with "openssl rand -base64 32".
GOOGLE_OAUTH_STATE_SECRET=
# [server-only, old names] Still read when the shared names above are not set. Remove once you use the shared pair.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_OAUTH_STATE_SECRET=
# [server-only] YouTube Data API key for metadata and playlist lookups.
YOUTUBE_API_KEY=
# [server-only] Facebook Page token for managed Page video collections.
FACEBOOK_PAGE_ACCESS_TOKEN=
# [server-only] Timezone used to reset shared AI quotas (defaults to Asia/Dhaka).
QUOTA_TIMEZONE=
# [server-only] HMAC secret used to sign short-lived Drive URLs; generate a random 32-byte secret.
DRIVE_URL_SIGNING_SECRET=
# [server-only, recommended] Dedicated HMAC secret for Google sync plan tokens (preview -> confirm -> apply).
# If empty, plan tokens fall back to DRIVE_URL_SIGNING_SECRET, which means a leaked Drive URL secret could also
# forge plan tokens. Generate a different random 32-byte secret: openssl rand -base64 32
GOOGLE_SYNC_SIGNING_SECRET=

# [server-only, optional] Set to 1 to log Drive request timings (src/lib/server/timing.ts).
DRIVE_TIMING=

# [build-time, optional] Set to "enforce" to send Content-Security-Policy instead of Report-Only (next.config.js). Needs a redeploy.
CSP_MODE=
